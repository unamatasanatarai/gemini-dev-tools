#!/usr/bin/env bash

script_path="${BASH_SOURCE[0]:-}"
script_dir=""

if [[ "${script_path}" == */* ]]; then
    script_dir="${script_path%/*}"
fi

if [[ -n "${script_dir}" && -f "${script_dir}/gemini-common.sh" ]]; then
    source "${script_dir}/gemini-common.sh"
elif [[ -f "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh" ]]; then
    source "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh"
fi

usage() {
    printf 'Usage:\n'
    printf '  gemini-prompt [options] <prompt>\n'
    printf '  echo "prompt" | gemini-prompt [options]\n\n'
    printf 'Sends a prompt to the Google Gemini API using model fallback rotation and returns the response.\n\n'
    printf 'Options:\n'
    printf '  --system <instruction>  System instruction to guide model behavior.\n'
    printf '  -h, --help              Show this help message.\n'
}

system_instruction=""
prompt=""

while [[ $# -gt 0 ]]; do
    case "$1" in
    --system | --system-instruction)
        if [[ -n "${2:-}" ]]; then
            system_instruction="$2"
            shift 2
        else
            printf 'Error: missing value for %s\n' "$1" >&2
            exit 2
        fi
        ;;
    --system=* | --system-instruction=*)
        system_instruction="${1#*=}"
        shift
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    --)
        shift
        if [[ $# -gt 0 ]]; then
            prompt="$*"
        fi
        break
        ;;
    -)
        shift
        break
        ;;
    -*)
        printf 'Error: unknown option: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
    *)
        if [[ -z "${prompt}" ]]; then
            prompt="$1"
        else
            prompt="${prompt} $1"
        fi
        shift
        ;;
    esac
done

if [[ -z "${prompt}" || "${prompt}" == "-" ]]; then
    if [[ ! -t 0 ]]; then
        prompt="$(cat)"
    fi
fi

trimmed_prompt="${prompt#"${prompt%%[![:space:]]*}"}"
trimmed_prompt="${trimmed_prompt%"${trimmed_prompt##*[![:space:]]}"}"

if [[ -z "${trimmed_prompt}" ]]; then
    printf 'Error: empty prompt provided\n' >&2
    usage >&2
    exit 2
fi

if ! command -v curl >/dev/null 2>&1; then
    printf 'Error: missing dependency: curl\n' >&2
    exit 10
fi

if ! command -v jq >/dev/null 2>&1; then
    printf 'Error: missing dependency: jq\n' >&2
    exit 10
fi

api_key=""
if declare -F gemini_get_api_key >/dev/null 2>&1; then
    api_key="$(gemini_get_api_key 2>/dev/null)"
else
    api_key="${GEMINI_API_KEY:-${GOOGLE_API_KEY:-}}"
fi

if [[ -z "${api_key}" ]]; then
    printf 'Error: GEMINI_API_KEY is not set or configured\n' >&2
    printf "Run 'gemini-key set' or export GEMINI_API_KEY\n" >&2
    exit 12
fi

tmp_dir="${TMPDIR:-/tmp}/gemini-prompt-$$"
if [[ -d "${tmp_dir}" ]]; then
    rm -rf "${tmp_dir}"
fi

mkdir -m 700 "${tmp_dir}"
if [[ $? -ne 0 ]]; then
    printf 'Error: failed to create temporary directory: %s\n' "${tmp_dir}" >&2
    exit 1
fi
trap 'rm -rf "${tmp_dir}"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

prompt_file="${tmp_dir}/prompt.txt"
printf '%s\n' "${trimmed_prompt}" >"${prompt_file}"

request_file="${tmp_dir}/request.json"
response_file="${tmp_dir}/response.json"

models=()
if [[ -f "${GEMINI_ROTATION_FILE:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/gemini/rotation}" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        if [[ -n "${line}" && "${line}" != \#* ]]; then
            models+=("${line}")
        fi
    done <"${GEMINI_ROTATION_FILE:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/gemini/rotation}"
fi

if [[ ${#models[@]} -eq 0 ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -n "${line}" ]] && models+=("${line}")
    done < <(gemini_get_default_rotation)
fi

total_models="${#models[@]}"
if [[ ${total_models} -eq 0 ]]; then
    printf 'Error: no Gemini models available in rotation\n' >&2
    exit 19
fi

build_payload() {
    if [[ -n "${system_instruction}" ]]; then
        jq -n \
            --rawfile prompt "${prompt_file}" \
            --arg sys "${system_instruction}" \
            '{
                system_instruction: { parts: [{ text: $sys }] },
                contents: [{ role: "user", parts: [{ text: $prompt }] }],
                generationConfig: {
                    temperature: 0.2,
                    maxOutputTokens: 8192
                }
            }'
    else
        jq -n \
            --rawfile prompt "${prompt_file}" \
            '{
                contents: [{ role: "user", parts: [{ text: $prompt }] }],
                generationConfig: {
                    temperature: 0.2,
                    maxOutputTokens: 8192
                }
            }'
    fi
}

success=false
response_text=""

for i in "${!models[@]}"; do
    current_model="${models[i]}"
    printf 'Attempting model: %s...\n' "${current_model}" >&2
    api_url="https://generativelanguage.googleapis.com/v1beta/models/${current_model}:generateContent"

    build_payload >"${request_file}"
    http_status="$(curl -sS -w "%{http_code}" -o "${response_file}" --connect-timeout 15 --max-time 180 -X POST "${api_url}" -H "x-goog-api-key: ${api_key}" -H "Content-Type: application/json" --data-binary "@${request_file}" 2>/dev/null || printf '000')"

    if [[ "${http_status}" == "200" ]]; then
        extracted_text="$(
            jq -r '
                [.candidates[0].content.parts[]?.text // empty]
                | join("\n")
            ' "${response_file}" 2>/dev/null
        )"
        extracted_text="${extracted_text#"${extracted_text%%[![:space:]]*}"}"
        extracted_text="${extracted_text%"${extracted_text##*[![:space:]]}"}"

        if [[ "${extracted_text}" =~ ^\`\`\`([a-zA-Z0-9_-]+)?[[:space:]]*$'\n'(.*)$'\n'\`\`\`$ ]]; then
            extracted_text="${BASH_REMATCH[2]}"
            extracted_text="${extracted_text#"${extracted_text%%[![:space:]]*}"}"
            extracted_text="${extracted_text%"${extracted_text##*[![:space:]]}"}"
        fi

        if [[ -n "${extracted_text}" ]]; then
            response_text="${extracted_text}"
            success=true
            break
        fi
    fi

    fail_reason="HTTP ${http_status}"
    if [[ "${http_status}" == "200" ]]; then
        fail_reason="empty response"
    fi
    printf 'Warning: Model %s failed (%s).\n' \
        "${current_model}" "${fail_reason}" >&2
done

if [[ "${success}" != "true" ]]; then
    printf 'Error: Gemini API call failed across all attempted models\n' >&2
    exit 19
fi

printf '%s\n' "${response_text}"
