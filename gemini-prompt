#!/usr/bin/env bash

common_file="${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh"
[[ "${BASH_SOURCE[0]}" == */* && -f "${BASH_SOURCE[0]%/*}/gemini-common.sh" ]] && common_file="${BASH_SOURCE[0]%/*}/gemini-common.sh"
if [[ ! -f "${common_file}" ]]; then
    printf 'Error: gemini-common.sh not found\n' >&2
    exit 10
fi
source "${common_file}"

usage="Usage:
  gemini-prompt [options] <prompt>
  echo \"prompt\" | gemini-prompt [options]

Sends a prompt to the Google Gemini API using model fallback rotation and returns the response.

Options:
  --system <instruction>  System instruction to guide model behavior.
  -h, --help              Show this help message."

system_instruction=""
prompt=""

while [[ $# -gt 0 ]]; do
    case "$1" in
    --system | --system-instruction)
        if [[ -z "${2:-}" ]]; then
            printf 'Error: missing value for %s\n' "$1" >&2
            exit 2
        fi
        system_instruction="$2"
        shift 2
        ;;
    --system=* | --system-instruction=*)
        system_instruction="${1#*=}"
        shift
        ;;
    -h | --help)
        printf '%s\n' "${usage}"
        exit 0
        ;;
    --)
        shift
        prompt="${prompt:+${prompt} }$*"
        break
        ;;
    -)
        break
        ;;
    -*)
        printf 'Error: unknown option: %s\n%s\n' "$1" "${usage}" >&2
        exit 2
        ;;
    *)
        prompt="${prompt:+${prompt} }$1"
        shift
        ;;
    esac
done

if [[ -z "${prompt}" && ! -t 0 ]]; then
    IFS= read -r -d '' prompt
fi
prompt="${prompt#"${prompt%%[![:space:]]*}"}"
prompt="${prompt%"${prompt##*[![:space:]]}"}"
if [[ -z "${prompt}" ]]; then
    printf 'Error: empty prompt provided\n%s\n' "${usage}" >&2
    exit 2
fi

for dep in curl jq; do
    if ! command -v "${dep}" >/dev/null 2>&1; then
        printf 'Error: missing dependency: %s\n' "${dep}" >&2
        exit 10
    fi
done

if [[ -z "${GEMINI_KEY}" ]]; then
    printf 'Error: GEMINI_API_KEY is not set or configured\n' >&2
    printf "Run 'gemini-key set' or export GEMINI_API_KEY\n" >&2
    exit 12
fi

models=("${GEMINI_ROTATION[@]}")
if [[ -n "${GEMINI_MODEL:-}" ]]; then
    models=("${GEMINI_MODEL}")
    for m in "${GEMINI_ROTATION[@]}"; do
        [[ "${m}" != "${GEMINI_MODEL}" ]] && models+=("${m}")
    done
fi

request_json="$(jq -n -c --rawfile prompt /dev/stdin --arg sys "${system_instruction}" '
    {
        contents: [{ role: "user", parts: [{ text: $prompt }] }],
        generationConfig: { temperature: 0.2, maxOutputTokens: 8192 }
    }
    + (if $sys == "" then {} else { system_instruction: { parts: [{ text: $sys }] } } end)
' <<<"${prompt}")"
if [[ $? -ne 0 || -z "${request_json}" ]]; then
    printf 'Error: failed to build request payload\n' >&2
    exit 11
fi

for model in "${models[@]}"; do
    printf 'Attempting model: %s...\n' "${model}" >&2
    response="$(curl -sS -w $'\n%{http_code}' --connect-timeout 15 --max-time 180 \
        -X POST "${GEMINI_API_URL}/${model}:generateContent" \
        -H "x-goog-api-key: ${GEMINI_KEY}" \
        -H "Content-Type: application/json" \
        --data-binary @- <<<"${request_json}" 2>/dev/null)"
    http_status="${response##*$'\n'}"
    [[ "${http_status}" =~ ^[0-9]{3}$ ]] || http_status="000"
    if [[ "${http_status}" != "200" ]]; then
        printf 'Warning: Model %s failed (HTTP %s).\n' "${model}" "${http_status}" >&2
        continue
    fi
    text="$(jq -r '[.candidates[0].content.parts[]?.text // empty] | join("\n")' <<<"${response%$'\n'*}" 2>/dev/null)"
    text="${text#"${text%%[![:space:]]*}"}"
    text="${text%"${text##*[![:space:]]}"}"
    if [[ "${text}" =~ ^\`\`\`([a-zA-Z0-9_-]+)?[[:space:]]*$'\n'(.*)$'\n'\`\`\`$ ]]; then
        text="${BASH_REMATCH[2]}"
        text="${text#"${text%%[![:space:]]*}"}"
        text="${text%"${text##*[![:space:]]}"}"
    fi
    if [[ -n "${text}" ]]; then
        printf '%s\n' "${text}"
        exit 0
    fi
    printf 'Warning: Model %s failed (empty response).\n' "${model}" >&2
done

printf 'Error: Gemini API call failed across all attempted models\n' >&2
exit 19
