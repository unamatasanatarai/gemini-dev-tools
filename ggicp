#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
script_dir="$(cd -- "$(dirname -- "${script_path}")" >/dev/null 2>&1 && pwd -P)"

if [[ -n "${script_dir}" && -x "${script_dir}/ggic" ]]; then
    exec "${script_dir}/ggic" --push "$@"
elif command -v ggic >/dev/null 2>&1; then
    exec ggic --push "$@"
else
    printf 'Error: ggic command not found\n' >&2
    exit 1
fi
