#!/usr/bin/env bash

if [[ "${BASH_SOURCE[0]}" == */* && -x "${BASH_SOURCE[0]%/*}/ggic" ]]; then
    exec "${BASH_SOURCE[0]%/*}/ggic" --push "$@"
fi

if command -v ggic >/dev/null 2>&1; then
    exec ggic --push "$@"
fi

if [[ -x "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/ggic" ]]; then
    exec "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/ggic" --push "$@"
fi

printf 'Error: ggic command not found\n' >&2
exit 1
