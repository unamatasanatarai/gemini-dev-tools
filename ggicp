#!/usr/bin/env bash

script_path="${BASH_SOURCE[0]:-}"
script_dir=""

if [[ "${script_path}" == */* ]]; then
    script_dir="${script_path%/*}"
fi

if [[ -n "${script_dir}" && -x "${script_dir}/ggic" ]]; then
    exec "${script_dir}/ggic" --push "$@"
fi

if command -v ggic >/dev/null 2>&1; then
    exec ggic --push "$@"
fi

bin_dir="${XDG_BIN_HOME:-${HOME}/.local/bin}"
if [[ -x "${bin_dir}/ggic" ]]; then
    exec "${bin_dir}/ggic" --push "$@"
fi

printf 'Error: ggic command not found\n' >&2
exit 1
