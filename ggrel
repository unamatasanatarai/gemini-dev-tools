#!/usr/bin/env bash
# ggrel: test, bump VERSION, tag, push, and publish a GitHub release.
# Release notes are supplied by the caller (e.g. piped from gemini-release-notes).

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

info() {
    printf '\n==> %s\n' "$*"
}

usage() {
    cat <<'EOF'
Usage:
  ggrel <version> [options]

Arguments:
  <version>              Target version (e.g. 1.0.1 or v1.0.1).

Release Notes Options (Required):
  -f, --notes-file FILE  Read release notes from FILE (use "-" for stdin).
  --notes TEXT           Specify release notes inline as a string.
                         Can also be piped via stdin (e.g. gemini-release-notes 1.0.1 | ggrel 1.0.1).

Execution Modes:
  -n, --dry-run, --preview
                         Preview release actions without modifying the repo.

Customization Options:
  --app-name NAME        Application name for the release (defaults to directory name).
  --test-cmd CMD         Command to execute for pre-release tests.
  --build-cmd CMD        Command to execute for building release artifacts.
  -a, --attach FILE      Artifact file to attach to the GitHub release (repeatable).
  -h, --help             Show this help message.

Configuration Hooks:
  If a .release.sh or .git-release.sh file is present in the repository root,
  it will be sourced automatically. Supported hook variables:
    APP_NAME, TEST_CMD, BUILD_CMD, RELEASE_ASSETS

  ${version} / $version (or ${target_version}) in commands and asset paths
  are replaced with the target version.
EOF
}

# Read one line from the user, preferring /dev/tty so piped stdin stays usable.
# Usage: ask <var> <prompt>
ask() {
    local __reply=""
    printf '%s' "$2" >&2
    if { : </dev/tty; } 2>/dev/null; then
        IFS= read -r __reply </dev/tty
    elif [[ -t 0 ]]; then
        IFS= read -r __reply
    else
        return 1
    fi
    printf -v "$1" '%s' "${__reply}"
}

# Replace version placeholders in a string.
expand_version() {
    local s="$1"
    s="${s//\$\{target_version\}/${target_version}}"
    s="${s//\$target_version/${target_version}}"
    s="${s//\$\{version\}/${target_version}}"
    s="${s//\$version/${target_version}}"
    printf '%s' "${s}"
}

for dep in git gh; do
    command -v "${dep}" >/dev/null 2>&1 || die "Missing required dependency: ${dep}"
done

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "Must be run inside a Git repository."
cd "${repo_root}" || die "Failed to enter git repository root."

version_file="${repo_root}/VERSION"
app_name=""
target_version=""
test_cmd=""
build_cmd=""
notes_file=""
inline_notes=""
dry_run=false
assets=()

# Optional per-repo configuration hook.
if [[ -f .git-release.sh ]]; then
    source .git-release.sh
elif [[ -f .release.sh ]]; then
    source .release.sh
fi
app_name="${APP_NAME:-}"
test_cmd="${TEST_CMD:-}"
build_cmd="${BUILD_CMD:-}"
if declare -p RELEASE_ASSETS >/dev/null 2>&1; then
    assets+=("${RELEASE_ASSETS[@]}")
fi

while [[ $# -gt 0 ]]; do
    opt="$1"
    # Normalize "--opt=value" into "--opt" "value" for options taking a value.
    case "${opt}" in
    --app-name=* | -f=* | --notes-file=* | --notes=* | --test-cmd=* | --build-cmd=* | -a=* | --attach=*)
        set -- "${opt%%=*}" "${opt#*=}" "${@:2}"
        opt="$1"
        ;;
    esac
    case "${opt}" in
    --app-name | -f | --notes-file | --notes | --test-cmd | --build-cmd | -a | --attach)
        [[ -n "${2:-}" ]] || die "Missing value for ${opt}"
        case "${opt}" in
        --app-name) app_name="$2" ;;
        -f | --notes-file) notes_file="$2" ;;
        --notes) inline_notes="$2" ;;
        --test-cmd) test_cmd="$2" ;;
        --build-cmd) build_cmd="$2" ;;
        -a | --attach) assets+=("$2") ;;
        esac
        shift 2
        ;;
    -n | --dry-run | --preview)
        dry_run=true
        shift
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        die "Unknown option: ${opt}"
        ;;
    *)
        [[ -z "${target_version}" ]] || die "Unexpected extra positional argument: ${opt}"
        target_version="${opt}"
        shift
        ;;
    esac
done

app_name="${app_name:-${repo_root##*/}}"

previous_tag="$(git describe --tags --match "v[0-9]*" --abbrev=0 HEAD 2>/dev/null ||
    git describe --tags --abbrev=0 HEAD 2>/dev/null)"

# Release notes: --notes, then --notes-file, then piped stdin.
notes_content=""
if [[ -n "${inline_notes}" ]]; then
    notes_content="${inline_notes}"
elif [[ "${notes_file}" == "-" ]]; then
    notes_content="$(cat)"
elif [[ -n "${notes_file}" ]]; then
    [[ -f "${notes_file}" ]] || die "Release notes file not found: ${notes_file}"
    notes_content="$(<"${notes_file}")"
elif [[ ! -t 0 ]]; then
    notes_content="$(cat)"
fi
if [[ ! "${notes_content}" =~ [^[:space:]] ]]; then
    die "Release notes are required. Provide them using -f/--notes-file <file>, --notes <text>, or pipe from 'gemini-release-notes' (e.g. gemini-release-notes 1.0.1 | ggrel 1.0.1)."
fi

if [[ -z "${target_version}" ]]; then
    printf 'Previous release: %s\n' "${previous_tag:-(none)}" >&2
    ask target_version 'Target version: '
fi
target_version="${target_version#v}"
[[ -n "${target_version}" ]] || die "Specify a target version (e.g. ggrel 1.0.1)."
if [[ ! "${target_version}" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    die "Invalid target version: \"${target_version}\". Expected semver e.g. 1.0.1"
fi

test_cmd="$(expand_version "${test_cmd}")"
build_cmd="$(expand_version "${build_cmd}")"
for i in "${!assets[@]}"; do
    assets[i]="$(expand_version "${assets[i]}")"
done

if [[ "${dry_run}" == false ]]; then
    git diff --cached --quiet || die "You have staged changes. Commit or unstage them before releasing."
    if git show-ref --verify --quiet "refs/tags/v${target_version}"; then
        die "Tag v${target_version} already exists."
    fi
fi

separator='--------------------------------------------------'
printf '\n%s\n' '=================================================='
printf 'Release preview: %s v%s\n' "${app_name}" "${target_version}"
printf '%s\n' '=================================================='
printf 'Previous tag:     %s\n' "${previous_tag:-(none)}"
printf 'Target version:   v%s\n' "${target_version}"
printf 'Version file:     %s\n' "${version_file}"
if ((${#assets[@]} > 0)); then
    printf 'Release assets:   %s\n' "${assets[*]}"
fi
printf '\nRelease notes to be published:\n%s\n%s\n%s\n\n' "${separator}" "${notes_content}" "${separator}"

if [[ "${dry_run}" == true ]]; then
    printf '%s\n' "[Dry run] No changes, tags, or releases were performed."
    exit 0
fi

confirmation=""
ask confirmation "Proceed with release v${target_version}? Type 'yes' to continue: " ||
    die "Cannot prompt for confirmation without an interactive terminal (/dev/tty)."
if [[ "${confirmation}" != "yes" ]]; then
    printf '%s\n' "Release cancelled. No actions were performed."
    exit 0
fi

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/ggrel.XXXXXX")" || die "Failed to create temporary directory."
trap 'rm -rf "${tmp_dir}"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
release_notes_file="${tmp_dir}/release_notes.md"
printf '%s\n' "${notes_content}" >"${release_notes_file}"

if [[ -n "${test_cmd}" ]]; then
    info "Running pre-release tests: ${test_cmd}..."
    bash -c "${test_cmd}" || die "Pre-release tests failed."
fi

info "Updating version file (${version_file})..."
printf '%s\n' "${target_version}" >"${version_file}"
git add "${version_file}" || die "Failed to stage ${version_file}."
if ! git diff --cached --quiet -- "${version_file}"; then
    git commit -m "chore(release): bump version to v${target_version}" || die "Failed to commit version bump."
fi

if [[ -n "${build_cmd}" ]]; then
    info "Running build command: ${build_cmd}..."
    bash -c "${build_cmd}" || die "Release build command failed."
fi

for asset in "${assets[@]}"; do
    [[ -f "${asset}" ]] || die "Expected release asset was not found: ${asset}"
done

current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" ||
    die "Detached HEAD: refusing to push release branch."

info "Creating annotated tag v${target_version}..."
git tag -a "v${target_version}" -m "Release ${app_name} v${target_version}" ||
    die "Failed to create git tag v${target_version}."

info "Pushing branch ${current_branch}..."
git push origin "${current_branch}" || die "Failed to push branch ${current_branch} to origin."

info "Pushing tag v${target_version}..."
git push origin "v${target_version}" || die "Failed to push tag v${target_version} to origin."

info "Publishing GitHub release v${target_version} via gh..."
gh release create "v${target_version}" \
    --title "${app_name} v${target_version}" \
    --notes-file "${release_notes_file}" \
    "${assets[@]}" ||
    die "Failed to publish GitHub release via gh."

info "Release v${target_version} successfully completed!"
