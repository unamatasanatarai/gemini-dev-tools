#!/usr/bin/env bash

for arg in "$@"; do
    case "${arg}" in
    -h | --help)
        printf '%s\n' \
            'Usage:' \
            '  ggrel <version> [grel options]' \
            '' \
            'Generates release notes with gemini-release-notes, saves them to' \
            "  \${XDG_CACHE_HOME:-~/.cache}/gemini/release-notes/<repo>.md" \
            'and runs: grel -f <that file> <version> [grel options]' \
            '' \
            'All arguments are passed through to grel, except -f/--notes-file and --notes.' \
            '' \
            'Examples:' \
            '  ggrel 1.2.0' \
            '  ggrel 1.2.0 --dry-run' \
            '  ggrel 1.2.0 -a dist/bundle.tar.gz' \
            '' \
            'Options:' \
            '  -h, --help  Show this help message.'
        exit 0
        ;;
    -f | -f=* | --notes-file | --notes-file=* | --notes | --notes=*)
        printf 'Error: %s is not supported by ggrel (notes are generated). Use grel directly.\n' "${arg%%=*}" >&2
        exit 2
        ;;
    esac
done

bin_dir="${XDG_BIN_HOME:-${HOME:-}/.local/bin}"
self_dir=""
[[ "${BASH_SOURCE[0]}" == */* ]] && self_dir="${BASH_SOURCE[0]%/*}"

notes_cmd=""
if [[ -n "${self_dir}" && -x "${self_dir}/gemini-release-notes" ]]; then
    notes_cmd="${self_dir}/gemini-release-notes"
elif command -v gemini-release-notes >/dev/null 2>&1; then
    notes_cmd="gemini-release-notes"
elif [[ -x "${bin_dir}/gemini-release-notes" ]]; then
    notes_cmd="${bin_dir}/gemini-release-notes"
else
    printf 'Error: gemini-release-notes command not found\n' >&2
    exit 10
fi

grel_cmd=""
if [[ -n "${self_dir}" && -x "${self_dir}/grel" ]]; then
    grel_cmd="${self_dir}/grel"
elif command -v grel >/dev/null 2>&1; then
    grel_cmd="grel"
elif [[ -x "${bin_dir}/grel" ]]; then
    grel_cmd="${bin_dir}/grel"
else
    printf 'Error: grel command not found\n' >&2
    exit 10
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [[ $? -ne 0 || -z "${repo_root}" ]]; then
    printf 'Error: Must be run inside a Git repository.\n' >&2
    exit 11
fi

notes_dir="${XDG_CACHE_HOME:-${HOME:-}/.cache}/gemini/release-notes"
notes_file="${notes_dir}/${repo_root##*/}.md"

if [[ ! -d "${notes_dir}" ]]; then
    mkdir -m 0700 -p "${notes_dir}" 2>/dev/null
    if [[ $? -ne 0 ]]; then
        printf 'Error: Failed to create release notes directory: %s\n' "${notes_dir}" >&2
        exit 1
    fi
fi

printf '==> Generating release notes...\n' >&2
"${notes_cmd}" >"${notes_file}.tmp"
rc=$?
if ((rc != 0)); then
    rm -f "${notes_file}.tmp"
    printf 'Error: gemini-release-notes failed (exit %d).\n' "${rc}" >&2
    exit 3
fi
if [[ ! -s "${notes_file}.tmp" ]]; then
    rm -f "${notes_file}.tmp"
    printf 'Error: gemini-release-notes produced no output.\n' >&2
    exit 3
fi
mv -f "${notes_file}.tmp" "${notes_file}"
if [[ $? -ne 0 ]]; then
    printf 'Error: Failed to save release notes to %s\n' "${notes_file}" >&2
    exit 1
fi
printf '==> Release notes saved to %s\n' "${notes_file}" >&2

exec "${grel_cmd}" -f "${notes_file}" "$@"
