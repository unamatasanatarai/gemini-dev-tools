#!/usr/bin/env bash

script_path="${BASH_SOURCE[0]:-}"
script_dir=""

if [[ "${script_path}" == */* ]]; then
    script_dir="${script_path%/*}"
fi

if [[ -n "${script_dir}" && -f "${script_dir}/gemini-common.sh" ]]; then
    source "${script_dir}/gemini-common.sh"
elif [[ -f "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh" ]]; then
    source "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh"
fi

target_dir="${GEMINI_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/gemini}"
target_file="${GEMINI_ROTATION_FILE:-${target_dir}/rotation}"

action="${1:-}"
include_all=false

if [[ "${action}" == "-h" || "${action}" == "--help" || "${action}" == "help" ]]; then
    printf 'Usage: gemini-rotate-models [command|options]\n\n'
    printf 'Select and manage Google Gemini models to rotate through (e.g. for ggic fallbacks).\n'
    printf 'Selected models reside in XDG configuration (%s) and are\n' "${target_file}"
    printf 'strictly ordered from NEWEST to OLDEST.\n\n'
    printf 'Commands & Options:\n'
    printf '  (no args)             Interactive selection (uses fzf if available, or menu)\n'
    printf '  --show, -s            Display current rotation list in order\n'
    printf '  --reset               Reset rotation to recommended defaults\n'
    printf '  --set <m1,m2,...>     Set rotation list from comma-separated names\n'
    printf '  --add <model>         Add a model to rotation (re-sorted newest to oldest)\n'
    printf '  --remove <model>      Remove a model from rotation\n'
    printf '  --all                 Include specialized/preview models in interactive list\n'
    printf '  -h, --help            Show this help message\n\n'
    printf 'Examples:\n'
    printf '  gemini-rotate-models\n'
    printf '  gemini-rotate-models --show\n'
    printf '  gemini-rotate-models --reset\n'
    printf '  gemini-rotate-models --set gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash\n'
    exit 0
fi

if [[ "${action}" == "-s" || "${action}" == "--show" || "${action}" == "show" ]]; then
    printf 'Current Gemini model rotation order (newest -> oldest):\n'
    models=()
    if [[ -f "${target_file}" ]]; then
        printf 'Source: %s\n' "${target_file}"
        while IFS= read -r line || [[ -n "${line}" ]]; do
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            if [[ -n "${line}" && "${line}" != \#* ]]; then
                models+=("${line}")
            fi
        done <"${target_file}"
    else
        printf 'Source: built-in defaults (no %s found)\n' "${target_file}"
        while IFS= read -r line || [[ -n "${line}" ]]; do
            [[ -n "${line}" ]] && models+=("${line}")
        done < <(gemini_get_default_rotation)
    fi
    idx=1
    for m in "${models[@]}"; do
        printf '  %2d. %s\n' "${idx}" "${m}"
        ((idx++))
    done
    exit 0
fi

save_rotation_list() {
    local -a input_list=("$@")
    local -a sorted=()
    local line=""

    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -n "${line}" ]] && sorted+=("${line}")
    done < <(
        for item in "${input_list[@]}"; do
            printf '%s\n' "${item}"
        done | gemini_sort_models_newest_to_oldest
    )

    if [[ ${#sorted[@]} -eq 0 ]]; then
        printf 'Error: no models provided to save.\n' >&2
        return 1
    fi

    if [[ ! -d "${target_dir}" ]]; then
        mkdir -m 0700 -p "${target_dir}"
        if [[ $? -ne 0 ]]; then
            printf 'Error: failed to create config directory: %s\n' "${target_dir}" >&2
            return 1
        fi
    fi
    chmod 0700 "${target_dir}" 2>/dev/null

    printf '%s\n' "${sorted[@]}" >"${target_file}"
    if [[ $? -ne 0 ]]; then
        printf 'Error: failed to write rotation file: %s\n' "${target_file}" >&2
        return 1
    fi
    chmod 0644 "${target_file}" 2>/dev/null

    printf '\nUpdated rotation list saved to %s (ordered newest to oldest):\n' "${target_file}"
    local idx=1
    for m in "${sorted[@]}"; do
        printf '  %2d. %s\n' "${idx}" "${m}"
        ((idx++))
    done
}

if [[ "${action}" == "--reset" || "${action}" == "reset" ]]; then
    defaults=()
    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -n "${line}" ]] && defaults+=("${line}")
    done < <(gemini_get_default_rotation)
    save_rotation_list "${defaults[@]}"
    exit $?
fi

if [[ "${action}" == "--set" || "${action}" == "set" ]]; then
    shift
    if [[ $# -eq 0 ]]; then
        printf 'Error: --set requires a comma-separated or space-separated list of models\n' >&2
        exit 1
    fi
    models_raw="$*"
    IFS=', ' read -r -a input_models <<<"${models_raw}"
    save_rotation_list "${input_models[@]}"
    exit $?
fi

if [[ "${action}" == "--add" || "${action}" == "add" ]]; then
    shift
    if [[ $# -eq 0 ]]; then
        printf 'Error: --add requires a model name\n' >&2
        exit 1
    fi
    new_model="$1"
    existing_models=()
    if [[ -f "${target_file}" ]]; then
        while IFS= read -r line || [[ -n "${line}" ]]; do
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            if [[ -n "${line}" && "${line}" != \#* ]]; then
                existing_models+=("${line}")
            fi
        done <"${target_file}"
    else
        while IFS= read -r line || [[ -n "${line}" ]]; do
            [[ -n "${line}" ]] && existing_models+=("${line}")
        done < <(gemini_get_default_rotation)
    fi
    existing_models+=("${new_model}")
    save_rotation_list "${existing_models[@]}"
    exit $?
fi

if [[ "${action}" == "--remove" || "${action}" == "remove" ]]; then
    shift
    if [[ $# -eq 0 ]]; then
        printf 'Error: --remove requires a model name\n' >&2
        exit 1
    fi
    remove_model="$1"
    remaining_models=()
    if [[ -f "${target_file}" ]]; then
        while IFS= read -r line || [[ -n "${line}" ]]; do
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            if [[ -n "${line}" && "${line}" != \#* && "${line}" != "${remove_model}" ]]; then
                remaining_models+=("${line}")
            fi
        done <"${target_file}"
    else
        while IFS= read -r line || [[ -n "${line}" ]]; do
            if [[ -n "${line}" && "${line}" != "${remove_model}" ]]; then
                remaining_models+=("${line}")
            fi
        done < <(gemini_get_default_rotation)
    fi
    if [[ ${#remaining_models[@]} -eq 0 ]]; then
        printf 'Error: cannot remove all models from rotation\n' >&2
        exit 1
    fi
    save_rotation_list "${remaining_models[@]}"
    exit $?
fi

if [[ "${action}" == "--all" ]]; then
    include_all=true
    shift
fi

available_models=()
api_key=""
if declare -F gemini_get_api_key >/dev/null 2>&1; then
    api_key="$(gemini_get_api_key 2>/dev/null)"
else
    api_key="${GEMINI_API_KEY:-${GOOGLE_API_KEY:-}}"
fi

if [[ -n "${api_key}" ]] && command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    raw_json="$(curl -fsS -H "x-goog-api-key: ${api_key}" "https://generativelanguage.googleapis.com/v1beta/models" 2>/dev/null)"
    if [[ -n "${raw_json}" ]]; then
        if [[ "${include_all}" == true ]]; then
            while IFS= read -r line || [[ -n "${line}" ]]; do
                [[ -n "${line}" ]] && available_models+=("${line}")
            done < <(jq -r '.models[] | select(.supportedGenerationMethods[]? == "generateContent") | .name | sub("^models/"; "")' <<<"${raw_json}" | gemini_sort_models_newest_to_oldest)
        else
            while IFS= read -r line || [[ -n "${line}" ]]; do
                [[ -n "${line}" ]] && available_models+=("${line}")
            done < <(jq -r '.models[] | select(.supportedGenerationMethods[]? == "generateContent") | .name | sub("^models/"; "") | select(startswith("gemini-") and (test("tts|image|transcribe|robotics|banana|computer-use") | not))' <<<"${raw_json}" | gemini_sort_models_newest_to_oldest)
        fi
    fi
fi

if [[ ${#available_models[@]} -eq 0 ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -n "${line}" ]] && available_models+=("${line}")
    done < <(gemini_get_default_rotation)
fi

current_rotation=()
if [[ -f "${target_file}" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        if [[ -n "${line}" && "${line}" != \#* ]]; then
            current_rotation+=("${line}")
        fi
    done <"${target_file}"
else
    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -n "${line}" ]] && current_rotation+=("${line}")
    done < <(gemini_get_default_rotation)
fi

selected_models=()

if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    printf '\nLaunching interactive multi-select via fzf...\n'
    printf 'Use TAB to select/deselect items, Shift-TAB to unselect, Enter to confirm.\n\n'

    fzf_output="$(
        for m in "${available_models[@]}"; do
            printf '%s\n' "${m}"
        done | fzf \
            --multi \
            --prompt="Toggle models (TAB to toggle): " \
            --header="Rotate Models (Order enforced NEWEST -> OLDEST)" \
            --reverse \
            --height=50%
    )"

    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -n "${line}" ]] && selected_models+=("${line}")
    done <<<"${fzf_output}"
fi

if [[ ${#selected_models[@]} -eq 0 ]]; then
    printf '\nAvailable Models (Ordered Newest -> Oldest):\n\n'
    for i in "${!available_models[@]}"; do
        num=$((i + 1))
        m="${available_models[i]}"
        is_selected="[ ]"
        for cur in "${current_rotation[@]}"; do
            if [[ "${cur}" == "${m}" ]]; then
                is_selected="[x]"
                break
            fi
        done
        printf '%3d) %s %s\n' "${num}" "${is_selected}" "${m}"
    done

    printf '\nEnter model numbers to rotate through (e.g., "1,2,4,5" or "1-6" or "all")\n'
    printf 'Press Enter to keep current selection: '
    read -r choice
    choice="${choice#"${choice%%[![:space:]]*}"}"
    choice="${choice%"${choice##*[![:space:]]}"}"

    if [[ -z "${choice}" ]]; then
        selected_models=("${current_rotation[@]}")
    elif [[ "${choice}" == "all" ]]; then
        selected_models=("${available_models[@]}")
    else
        IFS=',' read -ra parts <<<"${choice}"
        for part in "${parts[@]}"; do
            part="${part//[[:space:]]/}"
            if [[ "${part}" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                start="${BASH_REMATCH[1]}"
                end="${BASH_REMATCH[2]}"
                for ((idx = start; idx <= end; idx++)); do
                    if ((idx >= 1 && idx <= ${#available_models[@]})); then
                        selected_models+=("${available_models[$((idx - 1))]}")
                    fi
                done
            elif [[ "${part}" =~ ^[0-9]+$ ]]; then
                idx="${part}"
                if ((idx >= 1 && idx <= ${#available_models[@]})); then
                    selected_models+=("${available_models[$((idx - 1))]}")
                fi
            else
                for m in "${available_models[@]}"; do
                    if [[ "${m}" == "${part}" ]]; then
                        selected_models+=("${m}")
                        break
                    fi
                done
            fi
        done
    fi
fi

if [[ ${#selected_models[@]} -eq 0 ]]; then
    printf 'No models selected. Rotation unchanged.\n'
    exit 0
fi

save_rotation_list "${selected_models[@]}"
