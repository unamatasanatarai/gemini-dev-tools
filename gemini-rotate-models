#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
script_dir="$(cd -- "$(dirname -- "${script_path}")" >/dev/null 2>&1 && pwd -P)"

if [[ -f "${script_dir}/gemini-common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${script_dir}/gemini-common.sh"
elif [[ -f "${XDG_BIN_HOME:-$HOME/.local/bin}/gemini-common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${XDG_BIN_HOME:-$HOME/.local/bin}/gemini-common.sh"
fi

usage() {
    cat <<EOF
Usage: ${0##*/} [command|options]

Select and manage Google Gemini models to rotate through (e.g. for ggic fallbacks).
Selected models reside in XDG configuration (~/.config/gemini/rotation) and are
strictly ordered from NEWEST to OLDEST.

Commands & Options:
  (no args)             Interactive selection (uses fzf if available, or menu)
  --show, -s            Display current rotation list in order
  --reset               Reset rotation to recommended defaults
  --set <m1,m2,...>     Set rotation list from comma-separated names
  --add <model>         Add a model to rotation (re-sorted newest to oldest)
  --remove <model>      Remove a model from rotation
  --all                 Include specialized/preview models in interactive list
  -h, --help            Show this help message

Examples:
  ${0##*/}
  ${0##*/} --show
  ${0##*/} --reset
  ${0##*/} --set gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash
EOF
}

fetch_available_models() {
    local include_all="${1:-false}"
    local api_key=""
    local raw_json=""

    if api_key="$(gemini_get_api_key 2>/dev/null)" && [[ -n "${api_key}" ]]; then
        raw_json="$(curl -fsS -H "x-goog-api-key: ${api_key}" "https://generativelanguage.googleapis.com/v1beta/models" 2>/dev/null || true)"
    fi

    if [[ -n "${raw_json}" ]] && command -v jq >/dev/null 2>&1; then
        if [[ "${include_all}" == "true" ]]; then
            printf '%s\n' "${raw_json}" | jq -r '
                .models[]
                | select(.supportedGenerationMethods[]? == "generateContent")
                | .name
                | sub("^models/"; "")
            ' | gemini_sort_models_newest_to_oldest
        else
            printf '%s\n' "${raw_json}" | jq -r '
                .models[]
                | select(.supportedGenerationMethods[]? == "generateContent")
                | .name
                | sub("^models/"; "")
            ' | gemini_sort_models_newest_to_oldest | grep "^gemini-" | grep -vE "tts|image|transcribe|robotics|banana|computer-use" || true
        fi
    else
        # Fallback to default list if offline or API unreachable
        gemini_get_default_rotation
    fi
}

save_rotation() {
    local target_file
    local target_dir
    local sorted_list

    target_dir="$(gemini_config_dir)"
    target_file="$(gemini_rotation_file)"

    mkdir -p -m 0700 "${target_dir}" 2>/dev/null || true
    chmod 0700 "${target_dir}" 2>/dev/null || true

    sorted_list="$(printf '%s\n' "$@" | gemini_sort_models_newest_to_oldest)"

    if [[ -z "${sorted_list}" ]]; then
        printf 'Error: no models provided to save.\n' >&2
        return 1
    fi

    printf '%s\n' "${sorted_list}" >"${target_file}"
    chmod 0644 "${target_file}" 2>/dev/null || true

    printf '\nUpdated rotation list saved to %s (ordered newest to oldest):\n' "${target_file}"
    printf '%s\n' "${sorted_list}" | awk '{printf "  %2d. %s\n", NR, $0}'
}

action="${1:-}"
include_all=false

case "${action}" in
-h | --help | help)
    usage
    exit 0
    ;;
-s | --show | show)
    rot_file="$(gemini_rotation_file)"
    printf 'Current Gemini model rotation order (newest -> oldest):\n'
    if [[ -f "${rot_file}" ]]; then
        printf 'Source: %s\n' "${rot_file}"
        gemini_get_rotation_models | awk '{printf "  %2d. %s\n", NR, $0}'
    else
        printf 'Source: built-in defaults (no %s found)\n' "${rot_file}"
        gemini_get_default_rotation | awk '{printf "  %2d. %s\n", NR, $0}'
    fi
    exit 0
    ;;
--reset | reset)
    defaults="$(gemini_get_default_rotation)"
    save_rotation "${defaults}"
    exit 0
    ;;
--set | set)
    shift || true
    if [[ $# -eq 0 ]]; then
        printf 'Error: --set requires a comma-separated or space-separated list of models\n' >&2
        exit 1
    fi
    models_raw="${*}"
    IFS=', ' read -r -a input_models <<<"${models_raw}"
    save_rotation "${input_models[@]}"
    exit 0
    ;;
--add | add)
    shift || true
    if [[ $# -eq 0 ]]; then
        printf 'Error: --add requires a model name\n' >&2
        exit 1
    fi
    new_model="$1"
    existing_models=()
    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -n "${line}" ]] && existing_models+=("${line}")
    done < <(gemini_get_rotation_models)
    existing_models+=("${new_model}")
    save_rotation "${existing_models[@]}"
    exit 0
    ;;
--remove | remove)
    shift || true
    if [[ $# -eq 0 ]]; then
        printf 'Error: --remove requires a model name\n' >&2
        exit 1
    fi
    remove_model="$1"
    remaining_models=()
    while IFS= read -r line || [[ -n "${line}" ]]; do
        if [[ -n "${line}" && "${line}" != "${remove_model}" ]]; then
            remaining_models+=("${line}")
        fi
    done < <(gemini_get_rotation_models)
    if [[ ${#remaining_models[@]} -eq 0 ]]; then
        printf 'Error: cannot remove all models from rotation\n' >&2
        exit 1
    fi
    save_rotation "${remaining_models[@]}"
    exit 0
    ;;
--all)
    include_all=true
    shift || true
    ;;
esac

# Interactive Selection
available_raw="$(fetch_available_models "${include_all}")"
available_models=()
while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ -n "${line}" ]] && available_models+=("${line}")
done <<<"${available_raw}"

if [[ ${#available_models[@]} -eq 0 ]]; then
    printf 'Error: no models available to select\n' >&2
    exit 1
fi

current_rotation=()
while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ -n "${line}" ]] && current_rotation+=("${line}")
done < <(gemini_get_rotation_models)

cyan=""
bold=""
green=""
dim=""
reset=""

if [[ -t 1 ]]; then
    cyan=$'\033[36m'
    bold=$'\033[1m'
    green=$'\033[32m'
    dim=$'\033[2m'
    reset=$'\033[0m'
fi

selected_models=()

if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    printf '\n%sLaunching interactive multi-select via fzf...%s\n' "${bold}" "${reset}"
    printf '%sUse TAB to select/deselect items, Shift-TAB to unselect, Enter to confirm.%s\n\n' "${dim}" "${reset}"

    fzf_output="$(
        for m in "${available_models[@]}"; do
            printf '%s\n' "${m}"
        done | fzf \
            --multi \
            --prompt="Toggle models (TAB to toggle): " \
            --header="Rotate Models (Order enforced NEWEST -> OLDEST)" \
            --reverse \
            --height=50%
    )"

    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -n "${line}" ]] && selected_models+=("${line}")
    done <<<"${fzf_output}"
fi

# Fallback terminal menu if fzf not used or cancelled
if [[ ${#selected_models[@]} -eq 0 ]]; then
    printf '\n%sAvailable Models (Ordered Newest -> Oldest):%s\n\n' "${bold}" "${reset}"
    for i in "${!available_models[@]}"; do
        num=$((i + 1))
        m="${available_models[i]}"
        is_selected="[ ]"
        for cur in "${current_rotation[@]}"; do
            if [[ "${cur}" == "${m}" ]]; then
                is_selected="[x]"
                break
            fi
        done
        printf "%s%3d)%s %s %s%s%s\n" "${bold}" "${num}" "${reset}" "${is_selected}" "${cyan}" "${m}" "${reset}"
    done

    printf '\n%sEnter model numbers to rotate through (e.g., "1,2,4,5" or "1-6" or "all")%s\n' "${bold}" "${reset}"
    printf '%sPress Enter to keep current selection: %s' "${dim}" "${reset}"
    read -r choice || true
    choice="${choice:-}"

    if [[ -z "${choice}" ]]; then
        selected_models=("${current_rotation[@]}")
    elif [[ "${choice}" == "all" ]]; then
        selected_models=("${available_models[@]}")
    else
        # Parse ranges like 1-4 and numbers like 1, 2, 5
        IFS=',' read -ra parts <<<"${choice}"
        for part in "${parts[@]}"; do
            part="$(echo "${part}" | tr -d ' ')"
            if [[ "${part}" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                start="${BASH_REMATCH[1]}"
                end="${BASH_REMATCH[2]}"
                for ((idx = start; idx <= end; idx++)); do
                    if ((idx >= 1 && idx <= ${#available_models[@]})); then
                        selected_models+=("${available_models[$((idx - 1))]}")
                    fi
                done
            elif [[ "${part}" =~ ^[0-9]+$ ]]; then
                idx="${part}"
                if ((idx >= 1 && idx <= ${#available_models[@]})); then
                    selected_models+=("${available_models[$((idx - 1))]}")
                fi
            else
                # Check direct model name
                for m in "${available_models[@]}"; do
                    if [[ "${m}" == "${part}" ]]; then
                        selected_models+=("${m}")
                        break
                    fi
                done
            fi
        done
    fi
fi

if [[ ${#selected_models[@]} -eq 0 ]]; then
    printf 'No models selected. Rotation unchanged.\n'
    exit 0
fi

save_rotation "${selected_models[@]}"
