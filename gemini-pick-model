#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
script_dir="$(cd -- "$(dirname -- "${script_path}")" >/dev/null 2>&1 && pwd -P)"

if [[ -f "${script_dir}/gemini-common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${script_dir}/gemini-common.sh"
elif [[ -f "${XDG_BIN_HOME:-$HOME/.local/bin}/gemini-common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${XDG_BIN_HOME:-$HOME/.local/bin}/gemini-common.sh"
fi

config_dir="$(gemini_config_dir)"
rot_file="$(gemini_rotation_file)"

list_cmd="gemini-list-models"
if [[ -n "${script_dir}" && -x "${script_dir}/${list_cmd}" ]]; then
    list_cmd="${script_dir}/${list_cmd}"
elif command -v "${list_cmd}" >/dev/null 2>&1; then
    list_cmd="$(command -v "${list_cmd}")"
else
    printf "Error: %s not found\n" "${list_cmd}" >&2
    exit 1
fi

raw_models="$("${list_cmd}" --generate-only --newest 2>/dev/null || "${list_cmd}" 2>/dev/null || true)"

if [[ -z "${raw_models}" ]]; then
    raw_models="$(gemini_get_default_rotation)"
fi

models=()
while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%"${line##*[![:space:]]}"}"
    line="${line#"${line%%[![:space:]]*}"}"
    if [[ -n "${line}" ]]; then
        models+=("${line}")
    fi
done <<<"${raw_models}"

if [[ ${#models[@]} -eq 0 ]]; then
    printf "Error: failed to retrieve models\n" >&2
    exit 3
fi

current_top="$(gemini_get_primary_model)"

cyan=""
bold=""
green=""
reset=""

if [[ -t 1 ]]; then
    cyan=$'\033[36m'
    bold=$'\033[1m'
    green=$'\033[32m'
    reset=$'\033[0m'
fi

printf "\n%sAvailable Gemini Models:%s (Current top model: %s%s%s)\n\n" "${bold}" "${reset}" "${green}" "${current_top}" "${reset}"

for i in "${!models[@]}"; do
    num=$((i + 1))
    marker=" "
    if [[ "${models[i]}" == "${current_top}" ]]; then
        marker="*"
    fi
    printf "%s%3d)%s %s %s%s%s\n" "${bold}" "${num}" "${reset}" "${marker}" "${cyan}" "${models[i]}" "${reset}"
done

printf "\n"

selected_model=""

if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    printf "%sSelect model to promote to top of rotation (Enter number, name, or filter):%s " "${bold}" "${reset}"
    read -r choice || true
    if [[ -z "${choice}" ]]; then
        fzf_choice=$(printf "%s\n" "${models[@]}" | fzf --prompt="Select top model: " --height=40% --reverse)
        if [[ -n "${fzf_choice}" ]]; then
            selected_model="${fzf_choice}"
        fi
    fi
else
    printf "%sSelect model (1-%d or model name) [%s]:%s " "${bold}" "${#models[@]}" "${current_top}" "${reset}"
    read -r choice || true
fi

if [[ -z "${selected_model}" ]]; then
    choice="${choice:-}"
    if [[ -z "${choice}" ]]; then
        selected_model="${current_top}"
    elif [[ "${choice}" =~ ^[0-9]+$ ]] && [[ "${choice}" -ge 1 ]] && [[ "${choice}" -le ${#models[@]} ]]; then
        selected_model="${models[$((choice - 1))]}"
    else
        matched=false
        for m in "${models[@]}"; do
            if [[ "${m}" == "${choice}" ]]; then
                selected_model="${m}"
                matched=true
                break
            fi
        done
        if [[ "${matched}" == false ]]; then
            printf "Error: invalid selection: %s\n" "${choice}" >&2
            exit 4
        fi
    fi
fi

# Move selected model to top of rotation list
existing_rotation=()
if [[ -f "${rot_file}" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
        line="${line%"${line##*[![:space:]]}"}"
        line="${line#"${line%%[![:space:]]*}"}"
        [[ -z "${line}" || "${line}" =~ ^# ]] && continue
        if [[ "${line}" != "${selected_model}" ]]; then
            existing_rotation+=("${line}")
        fi
    done <"${rot_file}"
fi

new_rotation=("${selected_model}" "${existing_rotation[@]}")

mkdir -p -m 0700 "${config_dir}" 2>/dev/null || true
chmod 0700 "${config_dir}" 2>/dev/null || true

printf '%s\n' "${new_rotation[@]}" >"${rot_file}"
chmod 0644 "${rot_file}" 2>/dev/null || true

# Clean up legacy model file if present
rm -f "${config_dir}/model" 2>/dev/null || true

printf "\n%sTop rotation model updated to:%s %s%s%s (saved in %s)\n" "${bold}" "${reset}" "${green}" "${selected_model}" "${reset}" "${rot_file}"
