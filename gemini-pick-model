#!/usr/bin/env bash
set -euo pipefail

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
config_dir="${XDG_CONFIG_HOME}/gemini-commit-message"
model_file="${config_dir}/model"

script_path="${BASH_SOURCE[0]}"
script_dir="$(cd -- "$(dirname -- "${script_path}")" >/dev/null 2>&1 && pwd -P)"
list_cmd="gemini-list-models"

if [[ -n "${script_dir}" && -x "${script_dir}/${list_cmd}" ]]; then
    list_cmd="${script_dir}/${list_cmd}"
elif command -v "${list_cmd}" >/dev/null 2>&1; then
    list_cmd="$(command -v "${list_cmd}")"
else
    printf "Error: %s not found\n" "${list_cmd}" >&2
    exit 1
fi

raw_models="$("${list_cmd}")"

if [[ -z "${raw_models}" ]]; then
    printf "Error: no models retrieved\n" >&2
    exit 2
fi

models=()

while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ -n "${line}" ]]; then
        models+=("${line}")
    fi
done <<<"${raw_models}"

if [[ ${#models[@]} -eq 0 ]]; then
    printf "Error: failed to parse models\n" >&2
    exit 3
fi

current_model="gemini-3.5-flash-lite"
if [[ -f "${model_file}" ]]; then
    IFS= read -r saved_model <"${model_file}" || true
    if [[ -n "${saved_model}" ]]; then
        current_model="${saved_model}"
    fi
fi

cyan=""
bold=""
green=""
reset=""

if [[ -t 1 ]]; then
    cyan=$'\033[36m'
    bold=$'\033[1m'
    green=$'\033[32m'
    reset=$'\033[0m'
fi

printf "\n%sAvailable Gemini Models:%s (Current default: %s%s%s)\n\n" "${bold}" "${reset}" "${green}" "${current_model}" "${reset}"

for i in "${!models[@]}"; do
    num=$((i + 1))
    marker=" "
    if [[ "${models[i]}" == "${current_model}" ]]; then
        marker="*"
    fi
    printf "%s%3d)%s %s %s%s%s\n" "${bold}" "${num}" "${reset}" "${marker}" "${cyan}" "${models[i]}" "${reset}"
done

printf "\n"

selected_model=""

if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    printf "%sSelect model (Enter number, name, or press Enter for interactive filter):%s " "${bold}" "${reset}"
    read -r choice || true
    if [[ -z "${choice}" ]]; then
        fzf_choice=$(printf "%s\n" "${models[@]}" | fzf --prompt="Select model: " --height=40% --reverse)
        if [[ -n "${fzf_choice}" ]]; then
            selected_model="${fzf_choice}"
        fi
    fi
else
    printf "%sSelect model (1-%d or model name) [%s]:%s " "${bold}" "${#models[@]}" "${current_model}" "${reset}"
    read -r choice || true
fi

if [[ -z "${selected_model}" ]]; then
    choice="${choice:-}"
    if [[ -z "${choice}" ]]; then
        selected_model="${current_model}"
    elif [[ "${choice}" =~ ^[0-9]+$ ]] && [[ "${choice}" -ge 1 ]] && [[ "${choice}" -le ${#models[@]} ]]; then
        selected_model="${models[$((choice - 1))]}"
    else
        matched=false
        for m in "${models[@]}"; do
            if [[ "${m}" == "${choice}" ]]; then
                selected_model="${m}"
                matched=true
                break
            fi
        done
        if [[ "${matched}" == false ]]; then
            printf "Error: invalid selection: %s\n" "${choice}" >&2
            exit 4
        fi
    fi
fi

mkdir -p "${config_dir}"
chmod 700 "${config_dir}"

printf "%s\n" "${selected_model}" >"${model_file}"

printf "\n%sDefault model updated to:%s %s%s%s (saved in %s)\n" "${bold}" "${reset}" "${green}" "${selected_model}" "${reset}" "${model_file}"
