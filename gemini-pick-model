#!/usr/bin/env bash

script_path="${BASH_SOURCE[0]:-}"
script_dir=""

if [[ "${script_path}" == */* ]]; then
    script_dir="${script_path%/*}"
fi

if [[ -n "${script_dir}" && -f "${script_dir}/gemini-common.sh" ]]; then
    source "${script_dir}/gemini-common.sh"
elif [[ -f "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh" ]]; then
    source "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh"
fi

config_dir="${GEMINI_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/gemini}"
rot_file="${GEMINI_ROTATION_FILE:-${config_dir}/rotation}"

list_cmd="gemini-list-models"
if [[ -n "${script_dir}" && -x "${script_dir}/${list_cmd}" ]]; then
    list_cmd="${script_dir}/${list_cmd}"
elif command -v "${list_cmd}" >/dev/null 2>&1; then
    list_cmd="$(command -v "${list_cmd}")"
else
    printf 'Error: %s not found\n' "${list_cmd}" >&2
    exit 1
fi

models=()
while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    if [[ -n "${line}" ]]; then
        models+=("${line}")
    fi
done < <("${list_cmd}" --generate-only --newest 2>/dev/null || "${list_cmd}" 2>/dev/null || gemini_get_default_rotation)

if [[ ${#models[@]} -eq 0 ]]; then
    printf 'Error: failed to retrieve models\n' >&2
    exit 3
fi

current_top=""
if declare -F gemini_get_primary_model >/dev/null 2>&1; then
    current_top="$(gemini_get_primary_model)"
fi
if [[ -z "${current_top}" ]]; then
    current_top="${models[0]}"
fi

printf '\nAvailable Gemini Models: (Current top model: %s)\n\n' "${current_top}"

for i in "${!models[@]}"; do
    num=$((i + 1))
    marker=" "
    if [[ "${models[i]}" == "${current_top}" ]]; then
        marker="*"
    fi
    printf '%3d) %s %s\n' "${num}" "${marker}" "${models[i]}"
done

printf '\n'

selected_model=""
choice=""

if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    printf 'Select model to promote to top of rotation (Enter number, name, or filter): '
    read -r choice
    if [[ -z "${choice}" ]]; then
        fzf_choice="$(
            for m in "${models[@]}"; do
                printf '%s\n' "${m}"
            done | fzf --prompt="Select top model: " --height=40% --reverse
        )"
        if [[ -n "${fzf_choice}" ]]; then
            selected_model="${fzf_choice}"
        fi
    fi
else
    printf 'Select model (1-%d or model name) [%s]: ' "${#models[@]}" "${current_top}"
    read -r choice
fi

if [[ -z "${selected_model}" ]]; then
    choice="${choice#"${choice%%[![:space:]]*}"}"
    choice="${choice%"${choice##*[![:space:]]}"}"

    if [[ -z "${choice}" ]]; then
        selected_model="${current_top}"
    elif [[ "${choice}" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#models[@]})); then
        selected_model="${models[$((choice - 1))]}"
    else
        matched=false
        for m in "${models[@]}"; do
            if [[ "${m}" == "${choice}" ]]; then
                selected_model="${m}"
                matched=true
                break
            fi
        done
        if [[ "${matched}" == false ]]; then
            printf 'Error: invalid selection: %s\n' "${choice}" >&2
            exit 4
        fi
    fi
fi

existing_rotation=()
if [[ -f "${rot_file}" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        if [[ -n "${line}" && "${line}" != \#* && "${line}" != "${selected_model}" ]]; then
            existing_rotation+=("${line}")
        fi
    done <"${rot_file}"
fi

new_rotation=("${selected_model}" "${existing_rotation[@]}")

if [[ ! -d "${config_dir}" ]]; then
    mkdir -m 0700 -p "${config_dir}"
    if [[ $? -ne 0 ]]; then
        printf 'Error: failed to create config directory: %s\n' "${config_dir}" >&2
        exit 1
    fi
fi

chmod 0700 "${config_dir}" 2>/dev/null

printf '%s\n' "${new_rotation[@]}" >"${rot_file}"
if [[ $? -ne 0 ]]; then
    printf 'Error: failed to write rotation file: %s\n' "${rot_file}" >&2
    exit 1
fi

chmod 0644 "${rot_file}" 2>/dev/null
rm -f "${config_dir}/model" 2>/dev/null

printf '\nTop rotation model updated to: %s (saved in %s)\n' "${selected_model}" "${rot_file}"
