#!/usr/bin/env bash

push_after_commit=false
staged_only=false
cli_model=""
current_branch=""
line=""
message=""

script_path="${BASH_SOURCE[0]:-}"
script_dir=""

if [[ "${script_path}" == */* ]]; then
    script_dir="${script_path%/*}"
fi

if [[ -n "${script_dir}" && -f "${script_dir}/gemini-common.sh" ]]; then
    source "${script_dir}/gemini-common.sh"
elif [[ -f "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh" ]]; then
    source "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh"
fi

generator="gemini-commit-message"
if [[ -n "${script_dir}" && -x "${script_dir}/${generator}" ]]; then
    generator="${script_dir}/${generator}"
elif command -v "${generator}" >/dev/null 2>&1; then
    generator="$(command -v "${generator}")"
else
    printf 'Error: generator command not found: %s\n' "${generator}" >&2
    exit 11
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
    --push)
        push_after_commit=true
        ;;
    --staged-only)
        staged_only=true
        ;;
    --model)
        if [[ -n "${2:-}" ]]; then
            cli_model="$2"
            shift
        fi
        ;;
    --model=*)
        cli_model="${1#*=}"
        ;;
    -h | --help)
        printf 'Usage: ggic [--push] [--staged-only] [--model <model_name>]\n'
        exit 0
        ;;
    *)
        printf 'Usage: ggic [--push] [--staged-only] [--model <model_name>]\n' >&2
        exit 2
        ;;
    esac
    shift
done

if ! command -v git >/dev/null 2>&1; then
    printf 'Error: missing dependency: git\n' >&2
    exit 12
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    printf 'Error: not inside a git repository\n' >&2
    exit 4
fi

tmp_dir="${TMPDIR:-/tmp}/ggic-$$"
if [[ -d "${tmp_dir}" ]]; then
    rm -rf "${tmp_dir}"
fi

mkdir -m 700 "${tmp_dir}"
if [[ $? -ne 0 ]]; then
    printf 'Error: failed to create temporary directory: %s\n' "${tmp_dir}" >&2
    exit 1
fi
trap 'rm -rf "${tmp_dir}"' EXIT INT TERM HUP

message_file="${tmp_dir}/message.txt"

if [[ "${push_after_commit}" == true ]]; then
    current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"
    if [[ $? -ne 0 || -z "${current_branch}" ]]; then
        printf 'Error: cannot push from a detached HEAD\n' >&2
        exit 5
    fi
fi

if [[ "${staged_only}" == false ]]; then
    git add --all
fi

if git diff --cached --quiet; then
    printf 'No changes to commit.\n'
    exit 0
fi

generator_status=0
if [[ -n "${cli_model}" ]]; then
    "${generator}" --model "${cli_model}" >"${message_file}"
    generator_status=$?
else
    "${generator}" >"${message_file}"
    generator_status=$?
fi

if [[ ${generator_status} -eq 12 ]]; then
    printf 'Error: GEMINI_API_KEY is not set or configured\n' >&2
    exit 12
fi

if [[ ${generator_status} -ne 0 ]]; then
    printf 'Error: commit message generator failed with status %d\n' "${generator_status}" >&2
    exit "${generator_status}"
fi

message=""
if [[ -f "${message_file}" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
        message+="${line}"$'\n'
    done <"${message_file}"
fi

message="${message#"${message%%[![:space:]]*}"}"
message="${message%"${message##*[![:space:]]}"}"

if [[ -z "${message}" ]]; then
    printf 'Error: generated commit message was empty\n' >&2
    exit 8
fi

printf 'Generated commit message:\n'
printf '%s\n' '-------------------------'
printf '%s\n' "${message}"
printf '%s\n' '-------------------------'

git commit -F "${message_file}" --
if [[ $? -ne 0 ]]; then
    printf 'Error: git commit failed\n' >&2
    exit 9
fi

if [[ "${push_after_commit}" == true ]]; then
    git push -u origin -- "${current_branch}"
fi
