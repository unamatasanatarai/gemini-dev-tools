#!/usr/bin/env bash
set -euo pipefail

push_after_commit=false
staged_only=false
cli_model=""
current_branch=""
line=""
message=""

script_path="${BASH_SOURCE[0]}"
script_dir="$(cd -- "$(dirname -- "${script_path}")" >/dev/null 2>&1 && pwd -P)"
generator="gemini-generate-commit-message"

if [[ -n "${script_dir}" && -x "${script_dir}/${generator}" ]]; then
    generator="${script_dir}/${generator}"
elif command -v "${generator}" >/dev/null 2>&1; then
    generator="$(command -v "${generator}")"
else
    printf 'Error: generator command not found: %s\n' "${generator}" >&2
    exit 11
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
    --push)
        push_after_commit=true
        ;;
    --staged-only)
        staged_only=true
        ;;
    --model)
        if [[ -n "${2:-}" ]]; then
            cli_model="$2"
            shift
        fi
        ;;
    --model=*)
        cli_model="${1#*=}"
        ;;
    -h | --help)
        printf 'Usage: %s [--push] [--staged-only] [--model <model_name>]\n' "${0##*/}"
        exit 0
        ;;
    *)
        printf 'Usage: %s [--push] [--staged-only] [--model <model_name>]\n' "${0##*/}" >&2
        exit 2
        ;;
    esac
    shift
done

if ! command -v git >/dev/null 2>&1; then
    printf 'Error: missing dependency: git\n' >&2
    exit 12
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    printf 'Error: not inside a git repository\n' >&2
    exit 4
fi

tmp_dir="$(mktemp -d -t ggic.XXXXXX)"
trap 'rm -rf "${tmp_dir}"' EXIT INT TERM HUP
chmod 700 "${tmp_dir}"

message_file="${tmp_dir}/message.txt"
branch_file="${tmp_dir}/branch.txt"

if [[ "${push_after_commit}" == true ]]; then
    if ! git symbolic-ref --quiet --short HEAD >"${branch_file}"; then
        printf 'Error: cannot push from a detached HEAD\n' >&2
        exit 5
    fi

    IFS= read -r current_branch <"${branch_file}" || true

    if [[ -z "${current_branch}" ]]; then
        printf 'Error: cannot push from a detached HEAD\n' >&2
        exit 5
    fi
fi

if [[ "${staged_only}" == false ]]; then
    git add --all
fi

if git diff --cached --quiet; then
    printf 'No changes to commit.\n'
    exit 0
fi

DEFAULT_MODELS=(
    gemini-pro-latest
    gemini-flash-lite-latest
    gemini-flash-latest
    gemini-4-argon
    gemini-3.8-flash-tts
    gemini-3.8-flash-lite-tts
    gemini-3.8-flash
    gemini-3.7-flash
    gemini-3.6-flash
    gemini-3.5-flash-lite
    gemini-3.5-flash
    gemini-3.1-flash-lite
    gemini-2.5-pro
    gemini-2.5-flash-lite
    gemini-2.5-flash
)

resolve_initial_model() {
    local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
    local model_file="${config_home}/gemini-commit-message/model"
    local saved_model=""

    if [[ -n "${cli_model}" ]]; then
        printf '%s\n' "${cli_model}"
        return 0
    fi

    if [[ -f "${model_file}" ]]; then
        IFS= read -r saved_model <"${model_file}" || true
        if [[ -n "${saved_model}" ]]; then
            printf '%s\n' "${saved_model}"
            return 0
        fi
    fi

    if [[ -n "${GEMINI_SUMMARY_MODEL:-}" ]]; then
        printf '%s\n' "${GEMINI_SUMMARY_MODEL}"
        return 0
    fi

    if [[ -n "${GIT_SUMMARY_MODEL:-}" ]]; then
        printf '%s\n' "${GIT_SUMMARY_MODEL}"
        return 0
    fi

    printf '%s\n' "gemini-3.5-flash-lite"
}

initial_model="$(resolve_initial_model)"
models_to_try=("${initial_model}")
for candidate in "${DEFAULT_MODELS[@]}"; do
    if [[ "${candidate}" != "${initial_model}" ]]; then
        models_to_try+=("${candidate}")
    fi
done

success=false
total_models="${#models_to_try[@]}"

for i in "${!models_to_try[@]}"; do
    current_model="${models_to_try[i]}"
    generator_status=0

    "${generator}" --model "${current_model}" >"${message_file}" || generator_status=$?

    if [[ ${generator_status} -eq 12 ]]; then
        printf 'Error: GEMINI_API_KEY is not set or configured\n' >&2
        exit 12
    fi

    if [[ ${generator_status} -eq 0 ]]; then
        message=""
        while IFS= read -r line || [[ -n "${line}" ]]; do
            message+="${line}"$'\n'
        done <"${message_file}"

        message="${message#"${message%%[![:space:]]*}"}"
        message="${message%"${message##*[![:space:]]*}"}"

        if [[ -n "${message}" ]]; then
            success=true
            break
        fi
    fi

    if [[ $((i + 1)) -lt ${total_models} ]]; then
        next_model="${models_to_try[$((i + 1))]}"
        printf 'Warning: Model %s failed (exit %d). Trying fallback: %s...\n' \
            "${current_model}" "${generator_status}" "${next_model}" >&2
    else
        printf 'Warning: Model %s failed (exit %d).\n' \
            "${current_model}" "${generator_status}" >&2
    fi
done

if [[ "${success}" == false ]]; then
    printf 'Error: all candidate models failed to generate a commit message\n' >&2
    exit 8
fi

printf 'Generated commit message:\n'
printf '%s\n' '-------------------------'
printf '%s\n' "${message}"
printf '%s\n' '-------------------------'

git commit -F "${message_file}" --

if [[ "${push_after_commit}" == true ]]; then
    git push -u origin -- "${current_branch}"
fi
