#!/usr/bin/env bash
set -euo pipefail

push_after_commit=false
staged_only=false
cli_model=""
current_branch=""
line=""
message=""

script_path="${BASH_SOURCE[0]}"
script_dir="$(cd -- "$(dirname -- "${script_path}")" >/dev/null 2>&1 && pwd -P)"

if [[ -f "${script_dir}/gemini-common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${script_dir}/gemini-common.sh"
elif [[ -f "${XDG_BIN_HOME:-$HOME/.local/bin}/gemini-common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${XDG_BIN_HOME:-$HOME/.local/bin}/gemini-common.sh"
fi

generator="gemini-generate-commit-message"
if [[ -n "${script_dir}" && -x "${script_dir}/${generator}" ]]; then
    generator="${script_dir}/${generator}"
elif command -v "${generator}" >/dev/null 2>&1; then
    generator="$(command -v "${generator}")"
else
    printf 'Error: generator command not found: %s\n' "${generator}" >&2
    exit 11
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
    --push)
        push_after_commit=true
        ;;
    --staged-only)
        staged_only=true
        ;;
    --model)
        if [[ -n "${2:-}" ]]; then
            cli_model="$2"
            shift
        fi
        ;;
    --model=*)
        cli_model="${1#*=}"
        ;;
    -h | --help)
        printf 'Usage: %s [--push] [--staged-only] [--model <model_name>]\n' "${0##*/}"
        exit 0
        ;;
    *)
        printf 'Usage: %s [--push] [--staged-only] [--model <model_name>]\n' "${0##*/}" >&2
        exit 2
        ;;
    esac
    shift
done

if ! command -v git >/dev/null 2>&1; then
    printf 'Error: missing dependency: git\n' >&2
    exit 12
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    printf 'Error: not inside a git repository\n' >&2
    exit 4
fi

tmp_dir="$(mktemp -d -t ggic.XXXXXX)"
trap 'rm -rf "${tmp_dir}"' EXIT INT TERM HUP
chmod 700 "${tmp_dir}"

message_file="${tmp_dir}/message.txt"
branch_file="${tmp_dir}/branch.txt"

if [[ "${push_after_commit}" == true ]]; then
    if ! git symbolic-ref --quiet --short HEAD >"${branch_file}"; then
        printf 'Error: cannot push from a detached HEAD\n' >&2
        exit 5
    fi

    IFS= read -r current_branch <"${branch_file}" || true

    if [[ -z "${current_branch}" ]]; then
        printf 'Error: cannot push from a detached HEAD\n' >&2
        exit 5
    fi
fi

if [[ "${staged_only}" == false ]]; then
    git add --all
fi

if git diff --cached --quiet; then
    printf 'No changes to commit.\n'
    exit 0
fi

generator_status=0
if [[ -n "${cli_model}" ]]; then
    "${generator}" --model "${cli_model}" >"${message_file}" || generator_status=$?
else
    "${generator}" >"${message_file}" || generator_status=$?
fi

if [[ ${generator_status} -eq 12 ]]; then
    printf 'Error: GEMINI_API_KEY is not set or configured\n' >&2
    exit 12
fi

if [[ ${generator_status} -ne 0 ]]; then
    printf 'Error: commit message generator failed with status %d\n' "${generator_status}" >&2
    exit "${generator_status}"
fi

message=""
while IFS= read -r line || [[ -n "${line}" ]]; do
    message+="${line}"$'\n'
done <"${message_file}"

message="${message#"${message%%[![:space:]]*}"}"
message="${message%"${message##*[![:space:]]*}"}"

if [[ -z "${message}" ]]; then
    printf 'Error: generated commit message was empty\n' >&2
    exit 8
fi

printf 'Generated commit message:\n'
printf '%s\n' '-------------------------'
printf '%s\n' "${message}"
printf '%s\n' '-------------------------'

git commit -F "${message_file}" --

if [[ "${push_after_commit}" == true ]]; then
    git push -u origin -- "${current_branch}"
fi
