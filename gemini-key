#!/usr/bin/env bash

config_dir="${XDG_CONFIG_HOME:-${HOME:-}/.config}/gemini"
cred_file="${config_dir}/credentials"
cmd="${1:-help}"
shift

case "${cmd}" in
help | -h | --help)
    printf '%s\n' \
        'Usage: gemini-key <command> [arguments...]' \
        '' \
        'Securely store and supply Google Gemini API keys in an XDG-compliant location' \
        "(${cred_file}) for command-line tools without manual exports." \
        '' \
        'Commands:' \
        '  set [KEY]                 Store key (prompts silently if KEY is omitted)' \
        '  get                       Print raw key to stdout (for piping or script usage)' \
        '  run [--] <cmd> [args...]  Execute command with GEMINI_API_KEY and GOOGLE_API_KEY in memory' \
        "  env                       Output shell export statements for 'eval \"\$(gemini-key env)\"'" \
        '  status                    Check storage path, file existence, and permissions' \
        '  help, -h, --help          Show this help message' \
        '' \
        'Examples:' \
        '  gemini-key set' \
        '  echo "$MY_KEY" | gemini-key set' \
        '  gemini-key run -- gemini prompt "Hello world"' \
        '  gemini-key run -- python my_script.py' \
        '  eval "$(gemini-key env)"' \
        '  curl -H "x-goog-api-key: $(gemini-key get)" https://...'
    exit 0
    ;;
set | get | env | run | status) ;;
*)
    printf "Error: Unknown command '%s'\n\n" "${cmd}" >&2
    printf "Run 'gemini-key help' for usage instructions.\n" >&2
    exit 2
    ;;
esac

key=""
if [[ "${cmd}" == "set" ]]; then
    if [[ -n "${1:-}" ]]; then
        key="$1"
    elif [[ ! -t 0 ]]; then
        IFS= read -r key
    else
        IFS= read -r -s -p 'Enter Gemini API Key: ' key
        printf '\n' >&2
    fi
elif [[ -f "${cred_file}" ]]; then
    IFS= read -r key <"${cred_file}"
fi
key="${key//$'\r'/}"
key="${key#"${key%%[![:space:]]*}"}"
key="${key%"${key##*[![:space:]]}"}"

if [[ "${cmd}" == "set" ]]; then
    if [[ -z "${key}" ]]; then
        printf 'Error: API key cannot be empty.\n' >&2
        exit 1
    fi
    if [[ ! -d "${config_dir}" ]]; then
        mkdir -m 0700 -p "${config_dir}"
        if [[ $? -ne 0 ]]; then
            printf 'Error: failed to create directory: %s\n' "${config_dir}" >&2
            exit 1
        fi
    fi
    umask 077
    printf '%s\n' "${key}" 2>/dev/null >"${cred_file}"
    if [[ $? -ne 0 ]]; then
        printf 'Error: failed to write credentials file: %s\n' "${cred_file}" >&2
        exit 1
    fi
    chmod 0700 "${config_dir}" 2>/dev/null
    chmod 0600 "${cred_file}" 2>/dev/null
    printf 'Gemini API key stored successfully in %s\n' "${cred_file}" >&2
    exit 0
fi

if [[ "${cmd}" == "status" ]]; then
    printf 'XDG Config Directory : %s\n' "${config_dir}"
    printf 'Credentials File     : %s\n' "${cred_file}"
    if [[ ! -f "${cred_file}" ]]; then
        printf 'File Status          : Not found\n'
        printf "Key Configured       : No (run 'gemini-key set' to add a key)\n"
        exit 0
    fi
    perms="$(stat -f '%Lp' "${cred_file}" 2>/dev/null || stat -c '%a' "${cred_file}" 2>/dev/null)" || perms="unknown"
    masked="(empty)"
    ((${#key} > 0)) && masked="***"
    ((${#key} > 8)) && masked="${key:0:4}...${key: -4}"
    printf 'File Status          : Present (mode: %s)\n' "${perms}"
    printf 'Key Configured       : %s (length: %d chars)\n' "${masked}" "${#key}"
    if [[ "${perms}" != "600" && "${perms}" != "unknown" ]]; then
        printf '\nWarning: Permissions (%s) are looser than recommended 0600.\n' "${perms}" >&2
        printf 'Run '\''chmod 0600 "%s"'\'' to secure your key file.\n' "${cred_file}" >&2
        exit 0
    fi
    printf 'Security Check       : PASSED (restricted to owner)\n'
    exit 0
fi

if [[ "${cmd}" == "run" ]]; then
    [[ "${1:-}" == "--" ]] && shift
    if [[ $# -eq 0 ]]; then
        printf 'Error: No command specified to run.\n' >&2
        printf 'Usage: gemini-key run [--] <command> [args...]\n' >&2
        exit 2
    fi
fi

if [[ ! -f "${cred_file}" ]]; then
    printf 'Error: No Gemini API key found in %s\n' "${cred_file}" >&2
    printf "Run 'gemini-key set' to configure your key.\n" >&2
    exit 1
fi
if [[ -z "${key}" ]]; then
    printf 'Error: Credentials file %s is empty.\n' "${cred_file}" >&2
    printf "Run 'gemini-key set' to reconfigure your key.\n" >&2
    exit 1
fi

if [[ "${cmd}" == "get" ]]; then
    printf '%s' "${key}"
    exit 0
fi

if [[ "${cmd}" == "env" ]]; then
    escaped="${key//\'/\'\\\'\'}"
    printf "export GEMINI_API_KEY='%s'\n" "${escaped}"
    printf "export GOOGLE_API_KEY='%s'\n" "${escaped}"
    exit 0
fi

export GEMINI_API_KEY="${key}"
export GOOGLE_API_KEY="${key}"
exec "$@"
