#!/usr/bin/env bash

common_file="${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh"
[[ "${BASH_SOURCE[0]}" == */* && -f "${BASH_SOURCE[0]%/*}/gemini-common.sh" ]] && common_file="${BASH_SOURCE[0]%/*}/gemini-common.sh"
if [[ ! -f "${common_file}" ]]; then
    printf 'Error: gemini-common.sh not found\n' >&2
    exit 10
fi
source "${common_file}"

case "${1:-}" in
"") ;;
-h | --help)
    printf 'Usage: gemini-list-models\n\n'
    printf 'List available generation-capable Gemini models (sorted from newest to oldest).\n'
    exit 0
    ;;
*)
    printf 'Error: unknown option: %s\n' "$1" >&2
    printf 'Usage: gemini-list-models [-h|--help]\n' >&2
    exit 2
    ;;
esac

for dep in curl jq; do
    if ! command -v "${dep}" >/dev/null 2>&1; then
        printf 'Error: missing dependency: %s\n' "${dep}" >&2
        exit 1
    fi
done

if [[ -z "${GEMINI_KEY}" ]]; then
    printf 'Error: GEMINI_API_KEY is not set or configured\n' >&2
    printf "Run 'gemini-key set' or set GEMINI_API_KEY environment variable.\n" >&2
    exit 3
fi

raw_json="$(curl -fsS --connect-timeout 15 --max-time 60 -H @<(printf 'x-goog-api-key: %s\n' "${GEMINI_KEY}") "${GEMINI_API_URL}" 2>/dev/null)"
if [[ $? -ne 0 || -z "${raw_json}" ]]; then
    printf 'Error: failed to query models from Gemini API\n' >&2
    exit 4
fi

model_text="$(jq -r '.models[] | select(.supportedGenerationMethods[]? == "generateContent") | .name | sub("^models/"; "")' <<<"${raw_json}" 2>/dev/null)"
if [[ $? -ne 0 ]]; then
    printf 'Error: failed to parse models response\n' >&2
    exit 4
fi
models=()
gemini_lines_to_array models "${model_text}"

gemini_sort_models models
((${#models[@]} > 0)) && printf '%s\n' "${models[@]}"
exit 0
