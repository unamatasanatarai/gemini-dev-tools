#!/usr/bin/env bash

script_path="${BASH_SOURCE[0]:-}"
script_dir=""

if [[ "${script_path}" == */* ]]; then
    script_dir="${script_path%/*}"
fi

if [[ -n "${script_dir}" && -f "${script_dir}/gemini-common.sh" ]]; then
    source "${script_dir}/gemini-common.sh"
elif [[ -f "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh" ]]; then
    source "${XDG_BIN_HOME:-${HOME:-}/.local/bin}/gemini-common.sh"
fi

generate_only=false
sort_newest=false

while [[ $# -gt 0 ]]; do
    case "$1" in
    --generate-only)
        generate_only=true
        ;;
    --newest)
        sort_newest=true
        ;;
    -h | --help)
        printf 'Usage: gemini-list-models [options]\n\n'
        printf 'List available Gemini models for your API key.\n\n'
        printf 'Options:\n'
        printf '  --generate-only   Only list models supporting generateContent (text/code/chat)\n'
        printf '  --newest          Sort models from newest to oldest\n'
        printf '  -h, --help        Show this help message\n'
        exit 0
        ;;
    *)
        printf 'Error: unknown option: %s\n' "$1" >&2
        printf 'Usage: gemini-list-models [--generate-only] [--newest] [-h|--help]\n' >&2
        exit 2
        ;;
    esac
    shift
done

if ! command -v curl >/dev/null 2>&1; then
    printf 'Error: missing dependency: curl\n' >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    printf 'Error: missing dependency: jq\n' >&2
    exit 1
fi

api_key=""
if declare -F gemini_get_api_key >/dev/null 2>&1; then
    api_key="$(gemini_get_api_key 2>/dev/null)"
else
    api_key="${GEMINI_API_KEY:-${GOOGLE_API_KEY:-}}"
fi

if [[ -z "${api_key}" ]]; then
    printf 'Error: GEMINI_API_KEY is not set or configured\n' >&2
    printf "Run 'gemini-key set' or set GEMINI_API_KEY environment variable.\n" >&2
    exit 3
fi

raw_json="$(curl -fsS -H "x-goog-api-key: ${api_key}" "https://generativelanguage.googleapis.com/v1beta/models" 2>/dev/null)"
if [[ $? -ne 0 || -z "${raw_json}" ]]; then
    printf 'Error: failed to query models from Gemini API\n' >&2
    exit 4
fi

models=()
if [[ "${generate_only}" == true ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -n "${line}" ]] && models+=("${line}")
    done < <(jq -r '.models[] | select(.supportedGenerationMethods[]? == "generateContent") | .name | sub("^models/"; "")' <<<"${raw_json}")
else
    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -n "${line}" ]] && models+=("${line}")
    done < <(jq -r '.models[].name | sub("^models/"; "")' <<<"${raw_json}")
fi

if [[ ${#models[@]} -eq 0 ]]; then
    exit 0
fi

if [[ "${sort_newest}" == true ]]; then
    if declare -F gemini_sort_models_newest_to_oldest >/dev/null 2>&1; then
        for m in "${models[@]}"; do
            printf '%s\n' "${m}"
        done | gemini_sort_models_newest_to_oldest
    else
        printf '%s\n' "${models[@]}"
    fi
else
    n="${#models[@]}"
    for ((i = 1; i < n; i++)); do
        tmp_item="${models[i]}"
        j=$((i - 1))
        while ((j >= 0)) && [[ "${models[j]}" > "${tmp_item}" ]]; do
            models[j + 1]="${models[j]}"
            ((j--))
        done
        models[j + 1]="${tmp_item}"
    done
    for ((i = 0; i < n; i++)); do
        printf '%s\n' "${models[i]}"
    done
fi
